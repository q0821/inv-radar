---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sparkline from '../../../components/Sparkline.astro';
import technicalsData from '../../../../data/trends/technicals.json';
import { getChineseName } from '../../../lib/ticker-names';

const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const data: any = (await import('../../../../data/trends/tickers.json')).default;
  const tickers = (data?.tickers || []) as any[];
  return tickers.map(t => ({
    params: { symbol: t.symbol },
    props: { ticker: t, anchorDate: data?.anchorDate || '' },
  }));
}

interface Props {
  ticker: any;
  anchorDate: string;
}

const { ticker, anchorDate } = Astro.props;
const { symbol } = Astro.params;

// 技術面資料（build-technicals.mjs 產生），可能為 undefined（中文族群名、404 等）
const technicalsAll = (technicalsData as any) || {};
const tech = technicalsAll?.tickers?.[symbol || ''] || null;
const technicalsAnchor = technicalsAll?.anchorDate || anchorDate || '';

// ── 技術面文字判讀 helpers ────────────────────────────────────────────────
function fmtPrice(p: number | null | undefined, currency?: string | null) {
  if (typeof p !== 'number' || isNaN(p)) return '—';
  const sym = currency === 'TWD' ? 'NT$' : currency === 'USD' ? '$' : currency === 'HKD' ? 'HK$' : '';
  // 千分位
  const fixed = p >= 100 ? p.toFixed(0) : p.toFixed(2);
  const parts = fixed.split('.');
  parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  return `${sym}${parts.join('.')}`;
}

function fmtPct(p: number | null | undefined, withSign = true) {
  if (typeof p !== 'number' || isNaN(p)) return '—';
  const fixed = p.toFixed(1);
  if (!withSign) return `${fixed}%`;
  return p >= 0 ? `+${fixed}%` : `${fixed}%`;
}

// 東亞配色：漲紅、跌綠
function pctClass(p: number | null | undefined) {
  if (typeof p !== 'number' || isNaN(p)) return 'tech-value-neutral';
  if (p > 0) return 'tech-value-up';
  if (p < 0) return 'tech-value-down';
  return 'tech-value-neutral';
}

function vsMaLabel(p: number | null | undefined) {
  if (typeof p !== 'number' || isNaN(p)) return '—';
  return p >= 0 ? '站上' : '跌破';
}

function slopeLabel(p: number | null | undefined) {
  if (typeof p !== 'number' || isNaN(p)) return { text: '—', symbol: '→' };
  if (p > 0.3) return { text: '上彎', symbol: '↑' };
  if (p < -0.3) return { text: '下彎', symbol: '↓' };
  return { text: '持平', symbol: '→' };
}

function rsiLabel(r: number | null | undefined) {
  if (typeof r !== 'number' || isNaN(r)) return { text: '—', cls: 'tech-value-neutral' };
  if (r >= 70) return { text: '超買', cls: 'tech-rsi-hot' };
  if (r <= 30) return { text: '超賣', cls: 'tech-rsi-cold' };
  if (r >= 60) return { text: '偏強', cls: 'tech-rsi-strong' };
  if (r < 40) return { text: '偏弱', cls: 'tech-rsi-weak' };
  return { text: '中性', cls: 'tech-value-neutral' };
}

function volumeLabel(v: number | null | undefined) {
  if (typeof v !== 'number' || isNaN(v)) return { text: '—', cls: 'tech-value-neutral' };
  if (v >= 1.5) return { text: '大量', cls: 'tech-value-up' };
  if (v <= 0.7) return { text: '量縮', cls: 'tech-value-down' };
  return { text: '正常', cls: 'tech-value-neutral' };
}

function pvRelLabel(r: string | null | undefined) {
  if (r === 'sync') return { text: '量價同步 ✓', cls: 'tech-pv-sync' };
  if (r === 'divergence_up_low_vol') return { text: '漲勢無量', cls: 'tech-volume-warning' };
  if (r === 'divergence_down_high_vol') return { text: '跌勢放量', cls: 'tech-volume-warning' };
  return { text: '無明顯訊號', cls: 'tech-value-neutral' };
}

function verdictTagClass(tag: string) {
  if (tag === '中長線偏多' || tag === '短線轉強') return 'bull';
  if (tag === '中長線偏空' || tag === '短線轉弱') return 'bear';
  if (tag === '過熱' || tag === '超賣' || tag === '量價背離警訊') return 'warning';
  return '';
}

// ── 白話說明 helpers ───────────────────────────────────────────
function vsMaExplain(p: number | null | undefined, span: '中' | '長') {
  if (typeof p !== 'number' || isNaN(p)) return '';
  if (span === '中') {
    return p >= 0 ? '短中期偏多，跌破要留意' : '短中期偏弱，需觀察是否回穩';
  }
  return p >= 0 ? '長期趨勢偏多' : '長期趨勢偏弱';
}

function slopeExplain(p: number | null | undefined) {
  if (typeof p !== 'number' || isNaN(p)) return '';
  if (p > 0.3) return '趨勢仍在加速';
  if (p < -0.3) return '趨勢開始減弱';
  return '趨勢動能停滯';
}

function crossExplain(type: string | null | undefined) {
  if (type === 'golden') return '週線（5 日）由下往上穿過月線（20 日），常見短線轉強訊號';
  if (type === 'death') return '週線（5 日）由上往下跌破月線（20 日），常見短線轉弱訊號';
  return '近期週線與月線未出現交叉，趨勢延續或盤整中';
}

function rsiExplain(r: number | null | undefined) {
  if (typeof r !== 'number' || isNaN(r)) return '';
  if (r >= 70) return '短期漲幅過大，留意回檔風險';
  if (r <= 30) return '短期跌幅過大，可能出現技術反彈';
  if (r >= 60) return '動能強但尚未過熱（>=70 才警示）';
  if (r < 40) return '動能弱但尚未恐慌（<=30 才警示）';
  return '動能中性，無明顯訊號';
}

function volumeExplain(v: number | null | undefined) {
  if (typeof v !== 'number' || isNaN(v)) return '';
  if (v >= 1.5) return '明顯放量，買賣力道增強';
  if (v <= 0.7) return '明顯縮量，買盤觀望中';
  return '量能正常';
}

function pvRelExplain(r: string | null | undefined) {
  if (r === 'sync') return '漲跌與量同方向，量價結構健康';
  if (r === 'divergence_up_low_vol') return '漲勢缺乏成交支撐，留意假突破';
  if (r === 'divergence_down_high_vol') return '賣壓加重，下跌伴隨放量，需謹慎';
  return '近期量價無明顯訊號';
}

function verdictExplain(verdict: string[]) {
  if (!verdict || verdict.length === 0) return '';
  const hasBull = verdict.includes('中長線偏多');
  const hasBear = verdict.includes('中長線偏空');
  const hasShortStrong = verdict.includes('短線轉強');
  const hasShortWeak = verdict.includes('短線轉弱');
  const hot = verdict.includes('過熱');
  const cold = verdict.includes('超賣');
  const divergence = verdict.includes('量價背離警訊');

  const parts: string[] = [];
  if (hasBull && hasShortStrong) parts.push('中長期偏多 + 短期動能轉強，整體結構偏強');
  else if (hasBear && hasShortWeak) parts.push('中長期偏空 + 短期動能轉弱，整體結構偏弱');
  else if (hasBull) parts.push('長線結構偏多，短線無明顯轉折');
  else if (hasBear) parts.push('長線結構偏空，短線無明顯轉折');
  if (hot) parts.push('動能過強 — 短期回檔風險上升');
  if (cold) parts.push('動能過弱 — 短期反彈機率提高');
  if (divergence) parts.push('量價背離 — 訊號信賴度降低');
  if (parts.length === 0) parts.push('趨勢不明顯，建議搭配其他指標觀察');
  return parts.join('；');
}

const mentions = ticker.mentions || {};
const score = ticker.sentimentScore || {};
const mentionedBy = ticker.mentionedBy || [];
const timeline = (ticker.timeline || []) as Array<any>;

// 倒序時間軸供顯示（最新在上）
const timelineDesc = timeline.slice().sort((a, b) => (b.date || '').localeCompare(a.date || ''));

// 情緒 sparkline 的窗口切換（日曆日，與 leaderboard 一致；與技術面 MA 交易日不同）
type SparkWin = '7d' | '30d' | '90d';
const sparkWindows: SparkWin[] = ['7d', '30d', '90d'];
const sparkLabels: Record<SparkWin, string> = {
  '7d': '近 7 天',
  '30d': '近 30 天',
  '90d': '近 90 天',
};
function filterTimelineByWindow(win: SparkWin) {
  if (!anchorDate) return timeline;
  const dayMs = 24 * 60 * 60 * 1000;
  const days = win === '7d' ? 7 : win === '30d' ? 30 : 90;
  const cutoff = new Date(`${anchorDate}T00:00:00+08:00`).getTime() - days * dayMs;
  return timeline.filter((x: any) => new Date(`${x.date}T00:00:00+08:00`).getTime() >= cutoff);
}
const sparkByWindow: Record<SparkWin, any[]> = {
  '7d': filterTimelineByWindow('7d'),
  '30d': filterTimelineByWindow('30d'),
  '90d': filterTimelineByWindow('90d'),
};

function signalLabel(t: string) {
  if (t === 'bullish') return '看漲';
  if (t === 'bearish') return '看空';
  return '關注';
}

function signalClass(t: string) {
  if (t === 'bullish') return 'bullish';
  if (t === 'bearish') return 'bearish';
  return 'monitor';
}

function confidenceLabel(c: string) {
  const m: Record<string, string> = { high: '高信心', medium: '中信心', low: '低信心' };
  return m[c] || (c || '');
}

function horizonLabel(h: string) {
  const m: Record<string, string> = { short: '短線', medium: '中線', long: '長線' };
  return m[h] || (h || '');
}

function scoreClass(s: number) {
  if (s > 0.5) return 'trend-score-bull';
  if (s < -0.5) return 'trend-score-bear';
  return 'trend-score-neutral';
}

function fmtScore(s: number) {
  if (typeof s !== 'number' || isNaN(s)) return '0';
  return s > 0 ? `+${s}` : `${s}`;
}

// 把站上 symbol 轉成 TradingView 接受的格式
// - 港股 XXXX.HK → HKEX:XXXX（補 4 位數）
// - 美股 1-5 英文字母 → NASDAQ:XXX（NASDAQ 涵蓋率高、未涵蓋的 TV 內部會 fallback）
// - 台股 .TW / .TWO → 回 null（TradingView 對台股資料的免費 embed 授權有限制，
//   widget 會顯示「此商品僅在 TradingView 上可用」。改走 Yahoo 連結 fallback）
// - 其他（中文 ticker / 族群名 / 商品名等）→ 回 null，頁面顯示 fallback 文字
function toTradingViewSymbol(sym: string): string | null {
  if (!sym) return null;
  const s = String(sym).trim();
  const hkMatch = s.match(/^0*(\d{1,5})\.HK$/i);
  if (hkMatch) {
    const padded = hkMatch[1].padStart(4, '0');
    return `HKEX:${padded}`;
  }
  if (/^[A-Z]{1,5}$/.test(s)) return `NASDAQ:${s}`;
  return null;
}

// 對 ticker-shape 的 symbol 回傳 Yahoo Finance（台股版）連結
// 台股 .TW / .TWO、港股 .HK、美股、ETF 等都可以開
function toYahooFinanceUrl(sym: string): string | null {
  if (!sym) return null;
  const s = String(sym).trim();
  if (!/^[A-Z0-9.\-]+$/i.test(s)) return null; // 純中文 / 含全形字 → 不給連結
  return `https://tw.stock.yahoo.com/quote/${encodeURIComponent(s)}`;
}

const tvSymbol = toTradingViewSymbol(symbol || '');
const yahooUrl = toYahooFinanceUrl(symbol || '');
---
<BaseLayout title={`${symbol} 趨勢 - 投資訊號日報`}>
  <nav class="nav">
    <a href={base}>最新報告</a>
    <a href={`${base}archive/`}>歷史報告</a>
    <a href={`${base}trends/`}>趨勢觀察</a>
    <a href={`${base}workflow/`}>workflow 流程圖</a>
    <span style="color:var(--c-text-muted);font-size:0.9em;">/ {symbol}</span>
  </nav>

  <div class="card">
    <div class="card-body">
      <h1 class="section-title" style="margin-bottom:0.4em;">
        {symbol}
        {getChineseName(symbol || '') && (
          <span style="margin-left:0.5em;font-size:0.7em;font-weight:600;color:var(--c-text-muted);">{getChineseName(symbol || '')}</span>
        )}
      </h1>
      <p style="font-size:0.85em;color:var(--c-text-muted);margin-bottom:1em;">
        資料截至 {anchorDate}・共 {mentions.all || 0} 次提及
      </p>

      <div class="trend-stat-grid">
        <div class="trend-stat">
          <div class="trend-stat-label">近 7 天</div>
          <div class="trend-stat-row">
            <span class="trend-stat-mentions">{mentions['7d'] || 0} 次</span>
            <span class={`trend-score ${scoreClass(score['7d'] || 0)}`}>{fmtScore(score['7d'] || 0)}</span>
          </div>
        </div>
        <div class="trend-stat">
          <div class="trend-stat-label">近 30 天</div>
          <div class="trend-stat-row">
            <span class="trend-stat-mentions">{mentions['30d'] || 0} 次</span>
            <span class={`trend-score ${scoreClass(score['30d'] || 0)}`}>{fmtScore(score['30d'] || 0)}</span>
          </div>
        </div>
        <div class="trend-stat">
          <div class="trend-stat-label">近 90 天</div>
          <div class="trend-stat-row">
            <span class="trend-stat-mentions">{mentions['90d'] || 0} 次</span>
            <span class={`trend-score ${scoreClass(score['90d'] || 0)}`}>{fmtScore(score['90d'] || 0)}</span>
          </div>
        </div>
        <div class="trend-stat">
          <div class="trend-stat-label">累積</div>
          <div class="trend-stat-row">
            <span class="trend-stat-mentions">{mentions.all || 0} 次</span>
            <span class={`trend-score ${scoreClass(score.all || 0)}`}>{fmtScore(score.all || 0)}</span>
          </div>
        </div>
      </div>

      <div class="tv-chart-wrapper" data-tv-symbol={tvSymbol || ''}>
        {tvSymbol ? (
          <>
            <div style="font-size:0.85em;color:var(--c-text-muted);margin-bottom:0.4em;">即時 K 線（TradingView）</div>
            <div class="tv-chart-slot" data-tv-pending>
              <div class="tv-chart-placeholder">圖表載入中…</div>
            </div>
          </>
        ) : yahooUrl ? (
          <div class="tv-chart-fallback">
            <div style="margin-bottom:0.4em;">TradingView 對台股 / 上櫃股的免費 embed 授權有限制，無法直接嵌入 K 線。</div>
            <a href={yahooUrl} target="_blank" rel="noopener noreferrer" class="tv-chart-fallback-link">
              到 Yahoo 股市看 {symbol} K 線 →
            </a>
          </div>
        ) : (
          <div class="tv-chart-fallback">
            此標的「{symbol}」為中文族群名或非標準 ticker，暫不顯示 K 線。
          </div>
        )}
      </div>

      {tech && (
        <div class="tech-card">
          <div class="tech-card-header">
            <span class="tech-card-title">技術面快速判讀</span>
            <span class="tech-card-anchor">截至 {technicalsAnchor}</span>
          </div>

          <div class="tech-card-price">
            <span class="tech-card-symbol">{symbol}</span>
            <span class="tech-card-price-value">現價：{fmtPrice(tech.currentPrice, tech.currency)}</span>
            <span class={`tech-card-price-change ${pctClass(tech.changePct1d)}`}>
              ({fmtPct(tech.changePct1d)})
            </span>
          </div>

          <div class="tech-section">
            <div class="tech-section-title">均線結構</div>
            <div class="tech-row">
              <span class="tech-row-label">月線</span>
              <span class={`tech-row-value ${pctClass(tech.priceVsMa20Pct)}`}>{fmtPct(tech.priceVsMa20Pct)}</span>
              <span class="tech-row-hint">{vsMaLabel(tech.priceVsMa20Pct)}月線（20 日均）</span>
            </div>
            <div class="tech-row-explain">{vsMaExplain(tech.priceVsMa20Pct, '中')}</div>
            <div class="tech-row">
              <span class="tech-row-label">季線</span>
              <span class={`tech-row-value ${pctClass(tech.priceVsMa60Pct)}`}>{fmtPct(tech.priceVsMa60Pct)}</span>
              <span class="tech-row-hint">{vsMaLabel(tech.priceVsMa60Pct)}季線（60 日均）</span>
            </div>
            <div class="tech-row-explain">{vsMaExplain(tech.priceVsMa60Pct, '長')}</div>
            {(() => {
              const s = slopeLabel(tech.ma20Slope5dPct);
              return (
                <>
                  <div class="tech-row">
                    <span class="tech-row-label">月線斜率</span>
                    <span class={`tech-row-value ${pctClass(tech.ma20Slope5dPct)}`}>{s.symbol} {s.text}</span>
                    <span class="tech-row-hint">近 5 日 {fmtPct(tech.ma20Slope5dPct)}</span>
                  </div>
                  <div class="tech-row-explain">{slopeExplain(tech.ma20Slope5dPct)}</div>
                </>
              );
            })()}
          </div>

          <div class="tech-section">
            <div class="tech-section-title">短線訊號</div>
            {tech.cross5_20 && tech.cross5_20.type === 'golden' && tech.cross5_20.daysAgo != null ? (
              <>
                <div class="tech-row">
                  <span class="tech-row-label">週線×月線</span>
                  <span class="tech-row-value tech-cross-golden">⚡ {tech.cross5_20.daysAgo} 天前形成金叉</span>
                </div>
                <div class="tech-row-explain">{crossExplain('golden')}</div>
              </>
            ) : tech.cross5_20 && tech.cross5_20.type === 'death' && tech.cross5_20.daysAgo != null ? (
              <>
                <div class="tech-row">
                  <span class="tech-row-label">週線×月線</span>
                  <span class="tech-row-value tech-cross-death">⚡ {tech.cross5_20.daysAgo} 天前形成死叉</span>
                </div>
                <div class="tech-row-explain">{crossExplain('death')}</div>
              </>
            ) : (
              <>
                <div class="tech-row">
                  <span class="tech-row-label">週線×月線</span>
                  <span class="tech-row-value tech-value-neutral">近期無金叉 / 死叉</span>
                </div>
                <div class="tech-row-explain">{crossExplain('none')}</div>
              </>
            )}
            {(() => {
              const r = rsiLabel(tech.rsi14);
              return (
                <>
                  <div class="tech-row">
                    <span class="tech-row-label">RSI 14</span>
                    <span class={`tech-row-value ${r.cls}`}>{typeof tech.rsi14 === 'number' ? tech.rsi14.toFixed(1) : '—'} {r.text}</span>
                  </div>
                  <div class="tech-row-explain">{rsiExplain(tech.rsi14)}</div>
                </>
              );
            })()}
          </div>

          <div class="tech-section">
            <div class="tech-section-title">量能</div>
            {(() => {
              const v = volumeLabel(tech.volumeRatio);
              return (
                <>
                  <div class="tech-row">
                    <span class="tech-row-label">量比</span>
                    <span class={`tech-row-value ${v.cls}`}>{typeof tech.volumeRatio === 'number' ? `${tech.volumeRatio.toFixed(1)}× 均量` : '—'}</span>
                    <span class="tech-row-hint">{v.text}</span>
                  </div>
                  <div class="tech-row-explain">{volumeExplain(tech.volumeRatio)}</div>
                </>
              );
            })()}
            {(() => {
              const pv = pvRelLabel(tech.priceVolumeRelation);
              return (
                <>
                  <div class="tech-row">
                    <span class="tech-row-label">價量</span>
                    <span class={`tech-row-value ${pv.cls}`}>{pv.text}</span>
                  </div>
                  <div class="tech-row-explain">{pvRelExplain(tech.priceVolumeRelation)}</div>
                </>
              );
            })()}
          </div>

          {tech.verdict && tech.verdict.length > 0 && (
            <div class="tech-section">
              <div class="tech-section-title">綜合判讀</div>
              <div class="tech-verdict">
                {tech.verdict.map((tag: string) => (
                  <span class={`tech-verdict-tag ${verdictTagClass(tag)}`}>{tag}</span>
                ))}
              </div>
              <div class="tech-verdict-explain">{verdictExplain(tech.verdict)}</div>
            </div>
          )}

          <div class="tech-disclaimer">
            資料源：Yahoo Finance（每日 build 時更新）・僅供參考，不構成投資建議
          </div>
        </div>
      )}

      {timeline.length >= 2 && (
        <div class="trend-detail-spark">
          <div style="font-size:0.85em;color:var(--c-text-muted);margin-bottom:0.2em;">KOL 情緒走勢</div>
          <div class="spark-subtitle">線往上＝KOL 越來越看漲，往下＝越來越看空，走平＝近期沒被討論</div>
          <div class="trend-window-tabs spark-tabs" role="tablist">
            {sparkWindows.map(w => (
              <button
                type="button"
                class="trend-window-tab spark-tab"
                data-spark-window={w}
                role="tab"
                aria-selected={w === '30d' ? 'true' : 'false'}
              >{sparkLabels[w]}</button>
            ))}
          </div>
          {sparkWindows.map(w => (
            <div class="spark-pane" data-spark-pane={w} style={w === '30d' ? '' : 'display:none;'}>
              {sparkByWindow[w].length >= 2 ? (
                <Sparkline timeline={sparkByWindow[w]} width={680} height={80} maxPoints={90} />
              ) : (
                <p class="no-data" style="padding:0.6em 0;font-size:0.85em;">{sparkLabels[w]}內提及不足（少於 2 次），無法畫線</p>
              )}
            </div>
          ))}
          <div class="spark-legend">
            線＝<strong>選定窗口內</strong>歷次 KOL 提及的加權情緒分（看漲 +、看空 −）累加。
            採<strong>日曆日</strong>（含週末，與下方月線 / 季線用的「交易日」不同）。
            <span class="spark-legend-up">上升</span>＝看漲情緒累積、
            <span class="spark-legend-down">下降</span>＝看空累積。
            切短窗口（近 7 天）看最近熱度、長窗口（近 90 天）看整季趨勢；斜率比絕對高度重要。
          </div>
        </div>
      )}

      {mentionedBy.length > 0 && (
        <p style="margin-top:0.8em;font-size:0.9em;">
          <strong style="color:var(--c-text-muted);">提及來源：</strong>{mentionedBy.join('、')}
        </p>
      )}
    </div>
  </div>

  <div class="card">
    <div class="card-body">
      <h2 class="section-title">時間軸</h2>
      {timelineDesc.length === 0 ? (
        <p class="no-data" style="padding:1em;">尚無時間軸資料</p>
      ) : (
        <div class="trend-timeline">
          {timelineDesc.map((t: any) => (
            <div class={`trend-timeline-row ${signalClass(t.signal_type)}`}>
              <div class="trend-timeline-meta">
                <a href={`${base}reports/${t.date}/`} class="trend-timeline-date">{t.date}</a>
                <span class={`badge badge-confidence-${t.confidence || 'medium'}`}>{signalLabel(t.signal_type)}</span>
                {t.confidence && <span class={`badge badge-confidence-${t.confidence}`}>{confidenceLabel(t.confidence)}</span>}
                {t.timeHorizon && <span class={`badge badge-horizon-${t.timeHorizon}`}>{horizonLabel(t.timeHorizon)}</span>}
                {t.consensus && (t.consensus.includes('共識') || t.consensus.includes('分歧')) && (
                  <span class={`badge ${t.consensus.includes('共識') ? 'badge-consensus' : 'badge-divergence'}`}>{t.consensus}</span>
                )}
              </div>
              {(t.kol || t.reason) && (
                <div class="trend-timeline-body">
                  {t.kol && <strong>{t.kol}</strong>}
                  {t.kol && t.reason && '：'}
                  {t.reason}
                </div>
              )}
            </div>
          ))}
        </div>
      )}
    </div>
  </div>

  <script>
    // TradingView Advanced Real-Time Chart lazy loader
    // - 只在 wrapper 進入 viewport 後才注入 TradingView script，避免拖累首屏
    // - 響應 prefers-color-scheme，切換 theme
    // - 每個頁面只會嵌入一個 widget，所以這邊不做多 wrapper 處理
    (function () {
      const wrapper = document.querySelector('.tv-chart-wrapper');
      if (!wrapper) return;
      const tvSymbol = wrapper.getAttribute('data-tv-symbol') || '';
      if (!tvSymbol) return; // fallback 文字已由 SSR 處理
      const slot = wrapper.querySelector('.tv-chart-slot');
      if (!slot) return;

      let loaded = false;

      function getTheme() {
        try {
          // 優先用站上手動切換的 data-theme，否則跟隨系統
          var dt = document.documentElement.getAttribute('data-theme');
          if (dt === 'dark' || dt === 'light') return dt;
          return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
        } catch (_e) {
          return 'light';
        }
      }

      function clearSlot() {
        while (slot.firstChild) slot.removeChild(slot.firstChild);
      }

      function setPlaceholder(text) {
        clearSlot();
        const p = document.createElement('div');
        p.className = 'tv-chart-placeholder';
        p.textContent = text;
        slot.appendChild(p);
      }

      function loadWidget() {
        if (loaded) return;
        loaded = true;
        clearSlot();

        // TradingView 標準 embed pattern（container > widget div + 外部 script，config 以 textContent 注入）
        const container = document.createElement('div');
        container.className = 'tradingview-widget-container';
        container.style.width = '100%';
        container.style.height = '100%';

        const widgetDiv = document.createElement('div');
        widgetDiv.className = 'tradingview-widget-container__widget';
        widgetDiv.style.width = '100%';
        widgetDiv.style.height = '100%';
        container.appendChild(widgetDiv);

        const config = {
          autosize: true,
          symbol: tvSymbol,
          interval: 'D',
          timezone: 'Asia/Taipei',
          theme: getTheme(),
          style: '1',
          locale: 'zh_TW',
          enable_publishing: false,
          hide_side_toolbar: false,
          allow_symbol_change: false,
          calendar: false,
          support_host: 'https://www.tradingview.com'
        };

        const script = document.createElement('script');
        script.type = 'text/javascript';
        script.async = true;
        script.src = 'https://s3.tradingview.com/external-embedding/embed-widget-advanced-chart.js';
        // TradingView 規範：config 以 textContent 形式塞進 script tag（非 innerHTML / src）
        script.appendChild(document.createTextNode(JSON.stringify(config)));
        container.appendChild(script);

        slot.appendChild(container);
      }

      // IntersectionObserver lazy load
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              loadWidget();
              io.disconnect();
              break;
            }
          }
        }, { rootMargin: '200px' });
        io.observe(wrapper);
      } else {
        // 老瀏覽器直接載
        loadWidget();
      }

      // 主題變動（手動切換 themechange 事件 或 系統 prefers-color-scheme）→ 重載 widget
      try {
        const onChange = function () {
          if (!loaded) return;
          loaded = false;
          setPlaceholder('圖表重新載入中…');
          loadWidget();
        };
        window.addEventListener('themechange', onChange);
        const mq = window.matchMedia('(prefers-color-scheme: dark)');
        if (mq.addEventListener) {
          mq.addEventListener('change', onChange);
        } else if (mq.addListener) {
          mq.addListener(onChange);
        }
      } catch (_e) {
        // ignore
      }
    })();
  </script>

  <script>
    // 情緒 sparkline 窗口切換
    (function () {
      const tabs = document.querySelectorAll('.spark-tab');
      const panes = document.querySelectorAll('[data-spark-pane]');
      if (!tabs.length) return;
      function activate(win) {
        tabs.forEach(t => t.setAttribute('aria-selected', t.getAttribute('data-spark-window') === win ? 'true' : 'false'));
        panes.forEach(p => {
          p.style.display = p.getAttribute('data-spark-pane') === win ? '' : 'none';
        });
      }
      tabs.forEach(t => {
        t.addEventListener('click', () => {
          const win = t.getAttribute('data-spark-window');
          if (win) activate(win);
        });
      });
    })();
  </script>
</BaseLayout>
