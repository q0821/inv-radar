---
interface Props {
  report: any;
}

const { report } = Astro.props;

const date = report.date || '';
const totalSources = report.totalSources || 0;
const quickDigest = report.quickDigest || [];
const marketMood = report.marketMood || '';
const bullish = report.bullishSignals || [];
const bearish = report.bearishSignals || [];
const monitor = report.monitorSignals || [];
const insights = report.keyInsights || [];
const risks = report.riskAlerts || [];
const catalysts = report.upcomingCatalysts || [];
const episodes = report.episodeSummaries || [];
const anomalies = report.anomalies || {};

const bullCount = bullish.length;
const bearCount = bearish.length;
const monitorCount = monitor.length;
const total = bullCount + bearCount || 1;
const bullPct = Math.round((bullCount / total) * 100);
const bearPct = 100 - bullPct;

// 突發共識 / 預警：anomalies 各類加總
const anomalyCount =
  (anomalies.consensus?.length || 0) +
  (anomalies.repeatStress?.length || 0) +
  (anomalies.divergenceRising?.length || 0) +
  (anomalies.sectorHeat?.length || 0);

// Hero 定調標題：marketMood 優先，其次 quickDigest 第一句，再不然用預設
const heroHeadline = marketMood || quickDigest[0] || '今日投資訊號摘要';

// 市場溫度判讀（看漲占比）
let moodWord = '中性';
let moodClass = 'flat';
if (bullCount + bearCount === 0) {
  moodWord = '無訊號';
  moodClass = 'flat';
} else if (bullPct >= 60) {
  moodWord = '偏多';
  moodClass = 'bull';
} else if (bullPct <= 40) {
  moodWord = '偏空';
  moodClass = 'bear';
} else {
  moodWord = '中性';
  moodClass = 'flat';
}

// 半圓 gauge：180° arc，半徑 54，圓心 (60,60)
// 左端（180°）= 全空（綠），右端（0°）= 全多（紅）。指針角度依 bullPct。
const R = 54;
const CX = 60;
const CY = 60;
const arcLen = Math.PI * R; // 半圓弧長
// 看漲占比對應的填充（從右側紅端往左填）
const fillLen = (bullPct / 100) * arcLen;
// 指針角度：bullPct=100 → 0°（右），bullPct=0 → 180°（左）
const needleAngle = Math.PI * (1 - bullPct / 100);
const needleLen = R - 6;
const needleX = CX + needleLen * Math.cos(needleAngle);
const needleY = CY - needleLen * Math.sin(needleAngle);

function confidenceLabel(c: string) {
  const map: Record<string, string> = { high: '高信心', medium: '中信心', low: '低信心' };
  return map[c] || '中信心';
}

function horizonLabel(h: string) {
  const map: Record<string, string> = { short: '短線', medium: '中線', long: '長線' };
  return map[h] || '中線';
}

function fmtPct(v: number | null | undefined) {
  if (v == null || Number.isNaN(v)) return null;
  const sign = v > 0 ? '+' : '';
  return sign + v.toFixed(1) + '%';
}

function trendClass(v: number | null | undefined) {
  if (v == null || Number.isNaN(v)) return 'neutral';
  if (v > 0) return 'up';
  if (v < 0) return 'down';
  return 'neutral';
}

function currencyPrefix(c: string | null | undefined) {
  if (c === 'TWD') return 'NT$';
  if (c === 'HKD') return 'HK$';
  return '$';
}

function rsiClass(rsi: number | null | undefined) {
  if (rsi == null || Number.isNaN(rsi)) return '';
  if (rsi >= 70) return 'rsi-hot';
  if (rsi <= 30) return 'rsi-cold';
  return '';
}

function rsiNote(rsi: number | null | undefined) {
  if (rsi == null || Number.isNaN(rsi)) return '';
  if (rsi >= 70) return ' 超買';
  if (rsi <= 30) return ' 超賣';
  return '';
}
---

<!-- Hero 定調標題 -->
<div class="report-hero">
  <div class="report-hero-eyebrow">
    <span class="dot"></span>
    <span>今日定調</span>
  </div>
  <h1>{heroHeadline}</h1>
  <p class="report-hero-sub">{date}・分析 {totalSources} 個來源</p>
</div>

<!-- KPI tiles -->
<div class="kpi-grid">
  <div class="kpi">
    <div class="kpi-label">今日來源</div>
    <div class="kpi-value">{totalSources}</div>
    <div class="kpi-sub">Podcast / YouTube</div>
  </div>
  <div class="kpi">
    <div class="kpi-label">看漲訊號</div>
    <div class="kpi-value bull">{bullCount}</div>
    <div class="kpi-sub">看多標的數</div>
  </div>
  <div class="kpi">
    <div class="kpi-label">看空訊號</div>
    <div class="kpi-value bear">{bearCount}</div>
    <div class="kpi-sub">看空標的數</div>
  </div>
  <div class="kpi">
    <div class="kpi-label">突發共識 / 預警</div>
    <div class="kpi-value">{anomalyCount > 0 ? anomalyCount : '0'}</div>
    <div class="kpi-sub">{anomalyCount > 0 ? '異常訊號' : '累積中'}</div>
  </div>
  <div class="kpi kpi-gauge">
    <div class="kpi-label">市場溫度</div>
    <div class="gauge">
      <svg viewBox="0 0 120 70" role="img" aria-label={`市場溫度 ${moodWord}，看漲占比 ${bullPct}%`}>
        <defs>
          <linearGradient id="gaugeGrad" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="var(--c-bullish)" />
            <stop offset="0.5" stop-color="var(--c-monitor)" />
            <stop offset="1" stop-color="var(--c-bearish)" />
          </linearGradient>
        </defs>
        <!-- 底色軌 -->
        <path
          class="gauge-arc-track"
          d={`M ${CX - R} ${CY} A ${R} ${R} 0 0 1 ${CX + R} ${CY}`}
          fill="none"
          stroke-width="10"
          stroke-linecap="round"
        />
        <!-- 漸層填充（從綠到紅，依 bullPct 顯示填充長度） -->
        <path
          d={`M ${CX - R} ${CY} A ${R} ${R} 0 0 1 ${CX + R} ${CY}`}
          fill="none"
          stroke="url(#gaugeGrad)"
          stroke-width="10"
          stroke-linecap="round"
          stroke-dasharray={`${fillLen} ${arcLen}`}
        />
        <!-- 指針 -->
        <line x1={CX} y1={CY} x2={needleX} y2={needleY} stroke="var(--c-text)" stroke-width="2.5" stroke-linecap="round" />
        <circle cx={CX} cy={CY} r="4" fill="var(--c-text)" />
      </svg>
    </div>
    <div class="gauge-readout">
      <div class={`gauge-mood ${moodClass}`}>{moodWord}</div>
      <div class="gauge-pct">看漲占比 {bullPct}%</div>
    </div>
  </div>
</div>

<!-- Quick Digest -->
{quickDigest.length > 0 && (
  <div class="quick-digest">
    <h2>今日快速重點</h2>
    <ul>
      {quickDigest.map((point: string) => <li>{point}</li>)}
    </ul>
  </div>
)}

<!-- Dashboard 面板區（桌機 2 欄 masonry，手機單欄） -->
<div class="report-panels">
<!-- Bullish Signals -->
{bullish.length > 0 && (
  <div class="card">
    <div class="card-body">
      <h2 class="section-title bullish">看漲訊號 ({bullish.length})</h2>
      {bullish.map((sig: any) => (
        <div class="signal-card bullish">
          <div class="signal-card-head">
            <span class="signal-ticker bullish">{sig.ticker}</span>
            {sig.consensus?.includes('共識') && <span class="badge badge-consensus">{sig.consensus}</span>}
            {sig.consensus?.includes('分歧') && <span class="badge badge-divergence">{sig.consensus}</span>}
            <span class={`badge badge-horizon-${sig.timeHorizon || 'medium'}`}>{horizonLabel(sig.timeHorizon)}</span>
          </div>
          {sig.sources?.map((s: any) => (
            <div class="source-row">
              <strong>{s.kol}</strong>
              <span class={`badge badge-confidence-${s.confidence || 'medium'}`}>{confidenceLabel(s.confidence)}</span>
              ：{s.reason}
              {s.action && s.action !== '無' && <span class="badge-action bullish">{s.action}</span>}
            </div>
          ))}
          {sig.technicals && (
            <div class="signal-technicals">
              <span class="signal-technicals-label">行情</span>
              {sig.technicals.currentPrice != null && (
                <span class="signal-technicals-price">
                  {currencyPrefix(sig.technicals.currency)} {Number(sig.technicals.currentPrice).toLocaleString("en-US")}
                </span>
              )}
              {sig.technicals.priceVsMa20Pct != null && (
                <span class={`signal-technicals-item ${trendClass(sig.technicals.priceVsMa20Pct)}`}>
                  vs 月線 {fmtPct(sig.technicals.priceVsMa20Pct)}
                </span>
              )}
              {sig.technicals.rsi14 != null && (
                <span class={`signal-technicals-item rsi ${rsiClass(sig.technicals.rsi14)}`}>
                  RSI {sig.technicals.rsi14}{rsiNote(sig.technicals.rsi14)}
                </span>
              )}
              {sig.technicals.changePct5d != null && (
                <span class={`signal-technicals-item ${trendClass(sig.technicals.changePct5d)}`}>
                  5D {fmtPct(sig.technicals.changePct5d)}
                </span>
              )}
              {sig.technicals.volumeRatio != null && (
                <span class="signal-technicals-item">量 {sig.technicals.volumeRatio}× 均量</span>
              )}
            </div>
          )}
          {sig.priceLevel && sig.priceLevel !== '無' && sig.priceLevel !== 'N/A' && sig.priceLevel.trim() !== '' && (
            <div class="price-level">{sig.priceLevel}</div>
          )}
        </div>
      ))}
    </div>
  </div>
)}

<!-- Bearish Signals -->
{bearish.length > 0 && (
  <div class="card">
    <div class="card-body">
      <h2 class="section-title bearish">看空訊號 ({bearish.length})</h2>
      {bearish.map((sig: any) => (
        <div class="signal-card bearish">
          <div class="signal-card-head">
            <span class="signal-ticker bearish">{sig.ticker}</span>
            {sig.consensus?.includes('共識') && <span class="badge badge-consensus">{sig.consensus}</span>}
            {sig.consensus?.includes('分歧') && <span class="badge badge-divergence">{sig.consensus}</span>}
            <span class={`badge badge-horizon-${sig.timeHorizon || 'medium'}`}>{horizonLabel(sig.timeHorizon)}</span>
          </div>
          {sig.sources?.map((s: any) => (
            <div class="source-row">
              <strong>{s.kol}</strong>
              <span class={`badge badge-confidence-${s.confidence || 'medium'}`}>{confidenceLabel(s.confidence)}</span>
              ：{s.reason}
              {s.action && s.action !== '無' && <span class="badge-action bearish">{s.action}</span>}
            </div>
          ))}
          {sig.technicals && (
            <div class="signal-technicals">
              <span class="signal-technicals-label">行情</span>
              {sig.technicals.currentPrice != null && (
                <span class="signal-technicals-price">
                  {currencyPrefix(sig.technicals.currency)} {Number(sig.technicals.currentPrice).toLocaleString("en-US")}
                </span>
              )}
              {sig.technicals.priceVsMa20Pct != null && (
                <span class={`signal-technicals-item ${trendClass(sig.technicals.priceVsMa20Pct)}`}>
                  vs 月線 {fmtPct(sig.technicals.priceVsMa20Pct)}
                </span>
              )}
              {sig.technicals.rsi14 != null && (
                <span class={`signal-technicals-item rsi ${rsiClass(sig.technicals.rsi14)}`}>
                  RSI {sig.technicals.rsi14}{rsiNote(sig.technicals.rsi14)}
                </span>
              )}
              {sig.technicals.changePct5d != null && (
                <span class={`signal-technicals-item ${trendClass(sig.technicals.changePct5d)}`}>
                  5D {fmtPct(sig.technicals.changePct5d)}
                </span>
              )}
              {sig.technicals.volumeRatio != null && (
                <span class="signal-technicals-item">量 {sig.technicals.volumeRatio}× 均量</span>
              )}
            </div>
          )}
          {sig.divergence && (
            <div class="divergence-note">{sig.divergence}</div>
          )}
          {sig.priceLevel && sig.priceLevel !== '無' && sig.priceLevel !== 'N/A' && sig.priceLevel.trim() !== '' && (
            <div class="price-level">{sig.priceLevel}</div>
          )}
        </div>
      ))}
    </div>
  </div>
)}

<!-- Risk Alerts -->
{risks.length > 0 && (
  <div class="card">
    <div class="card-body">
      <h2 class="section-title risk">風險提醒</h2>
      <div class="risk-block">
        <ul>
          {risks.map((r: string) => <li>{r}</li>)}
        </ul>
      </div>
    </div>
  </div>
)}

<!-- Upcoming Catalysts -->
{catalysts.length > 0 && (
  <div class="card">
    <div class="card-body">
      <h2 class="section-title catalyst">近期催化劑</h2>
      <div class="catalyst-block">
        {catalysts.map((c: any) => (
          <div class="catalyst-item">
            <span class="catalyst-date">{c.date}</span>
            <span>{c.event}</span>
            {c.tickers?.map((t: string) => <span class="catalyst-ticker">{t}</span>)}
          </div>
        ))}
      </div>
    </div>
  </div>
)}

<!-- Monitor Signals -->
{monitor.length > 0 && (
  <div class="card">
    <div class="card-body">
      <h2 class="section-title monitor">值得關注 ({monitor.length})</h2>
      {monitor.map((sig: any) => (
        <div class="signal-card monitor">
          <div class="signal-card-head">
            <span class="signal-ticker monitor">{sig.topic}</span>
            <span class={`badge badge-horizon-${sig.timeHorizon || 'medium'}`}>{horizonLabel(sig.timeHorizon)}</span>
          </div>
          <p style="margin:0;font-size:var(--fs-sm);line-height:1.6;color:var(--c-text-secondary);">{sig.reason}</p>
          <p style="margin-top:0.4em;font-size:var(--fs-xs);color:var(--c-text-muted);">
            提及來源：{(sig.mentionedBy || []).join('、')}
          </p>
        </div>
      ))}
    </div>
  </div>
)}

<!-- Key Insights -->
{insights.length > 0 && (
  <div class="card">
    <div class="card-body">
      <h2 class="section-title insight">KOL 獨特觀點</h2>
      <div class="insight-list">
        {insights.map((ins: any) => {
          if (typeof ins === 'string') {
            return <div class="insight-item insight-item-simple">{ins}</div>;
          }
          const sourceText = Array.isArray(ins.source)
            ? ins.source.join('、')
            : (ins.source || '');
          return (
            <div class="insight-item">
              {(ins.sector || ins.timeHorizon) && (
                <div class="insight-tags">
                  {ins.sector && <span class="badge badge-sector">{ins.sector}</span>}
                  {ins.timeHorizon && (
                    <span class={`badge badge-horizon-${ins.timeHorizon}`}>{horizonLabel(ins.timeHorizon)}</span>
                  )}
                </div>
              )}
              <div class="insight-headline">{ins.insight}</div>
              {ins.reasoning && (
                <div class="insight-reasoning">
                  <strong>推導邏輯：</strong>{ins.reasoning}
                </div>
              )}
              {sourceText && <div class="insight-source">— {sourceText}</div>}
            </div>
          );
        })}
      </div>
    </div>
  </div>
)}

<!-- Episode Summaries -->
{episodes.length > 0 && (
  <div class="card">
    <div class="card-body">
      <h2 class="section-title">節目重點摘要</h2>
      {episodes.map((ep: any) => {
        const icon = ep.source === 'youtube' ? '🎬' : '🎧';
        const linkClass = ep.source === 'youtube' ? 'youtube' : 'podcast';
        const linkText = ep.source === 'youtube' ? '前往觀看' : '前往收聽';
        return (
          <div class="episode-card">
            <div class="episode-meta">
              <span class="episode-icon">{icon}</span>
              <div>
                <div class="episode-podcast">{ep.podcast}</div>
                <div class="episode-title">{ep.episode}</div>
              </div>
            </div>
            {ep.highlights && ep.highlights.length > 0 && (
              <ul class="episode-highlights">
                {ep.highlights.map((h: string) => <li>{h}</li>)}
              </ul>
            )}
            {(ep.detailedSummary || ep.oneLiner) && (
              <div class="episode-summary">{ep.detailedSummary || ep.oneLiner}</div>
            )}
            {ep.episodeLink && (
              <a href={ep.episodeLink} target="_blank" rel="noopener noreferrer" class={`episode-link ${linkClass}`}>
                {linkText}
              </a>
            )}
          </div>
        );
      })}
    </div>
  </div>
)}
</div>
